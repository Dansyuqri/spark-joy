{
  "name": "@dansyuqri/spark-joy",
  "version": "0.10.1",
  "description": "Break a huge PR into reviewable chunks and review it batch by batch in a local app.",
  "keywords": [
    "code-review",
    "pull-request",
    "merge-request",
    "claude-code",
    "codex",
    "gemini-cli",
    "agent-skills",
    "skill",
    "diff",
    "github",
    "gitlab"
  ],
  "homepage": "https://github.com/Dansyuqri/spark-joy#readme",
  "bugs": {
    "url": "https://github.com/Dansyuqri/spark-joy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dansyuqri/spark-joy.git"
  },
  "license": "MIT",
  "author": "dansyuqri",
  "type": "module",
  "bin": {
    "spark-joy": "bin/spark-joy.mjs"
  },
  "files": [
    "bin",
    "dist",
    "plugin/skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:app",
    "prepare": "npm run build",
    "build:cli": "tsup",
    "build:app": "vite build",
    "dev:app": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build:app && vitest run --config vitest.e2e.config.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.49.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
